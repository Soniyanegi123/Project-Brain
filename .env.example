# Copy this file to .env and set local values. Never commit .env.
APP_ENV=development
HOST=127.0.0.1
PORT=5000

# Optional single-password workspace gate. Production requires 16+ characters.
APP_ACCESS_PASSWORD=

# Production requires a random value of at least 32 characters.
SECRET_KEY=

# Local development only. Production requires shared Redis-backed storage.
RATELIMIT_STORAGE_URI=memory://

# Optional LLM synthesis and semantic retrieval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional GitHub token. Public repositories work without one within rate limits.
GITHUB_TOKEN=
GITHUB_MAX_PAGES=3
GITHUB_COMMIT_DETAIL_LIMIT=10
GITHUB_PR_DETAIL_LIMIT=5
GITHUB_FILE_LIMIT=250

# Optional override for isolated testing or alternate local storage.
PROJECT_BRAIN_DB=
